# ==============================================================================
# MobyGuard Environment Configuration
# ==============================================================================

# Application Image Tag, Host Port & Allowed Hosts
API_VERSION=latest
API_PORT=5090
ALLOWED_HOSTS=localhost
CERTS_DIR=./certs

# ==============================================================================
# Database (SQLite)
# ==============================================================================
SQLITE_CONN_STRING=Data Source=/app/data/mobyguard.db

# ==============================================================================
# Upstream Docker Registry / CNCF Distribution
# ==============================================================================
REGISTRY_URL=http://registry:5000
# Shared secret required to enable POST /api/v1/Registry/events (X-Registry-Webhook-Secret or Bearer)
# When empty, /api/v1/Registry/events is disabled and returns 401 Unauthorized.
REGISTRY_WEBHOOK_SECRET=
