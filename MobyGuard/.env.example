# ==============================================================================
# MobyGuard Environment Configuration
# ==============================================================================

# Application Image Tag
API_VERSION=latest

# API & UI Host Port (default: 5090)
API_PORT=5090

# Directory on host containing registry-auth.crt and registry-auth.key
CERTS_DIR=./certs

# ==============================================================================
# Database (PostgreSQL)
# ==============================================================================
DB_USER=mobyguard
DB_USER_PASS=change_this_postgres_password
DB_NAME=mobyguard
DB_PORT=127.0.0.1:5432
# Optional full connection string override (uncomment if using external database):
# POSTGRES_CONN_STRING=Host=postgres;Port=5432;Database=mobyguard;Username=mobyguard;Password=change_this_postgres_password;

# ==============================================================================
# Redis (Session & Rate-limiting cache)
# ==============================================================================
REDIS_PASS=change_this_redis_password
# Optional full Redis connection string override (uncomment if using external Redis):
# REDIS_CONN_STRING=redis:6379,password=change_this_redis_password

# ==============================================================================
# Docker Registry v3 Integration
# ==============================================================================
# Internal or external URL of the Docker Distribution v3 container
REGISTRY_URL=http://registry:5000
REGISTRY_TOKEN_ISSUER=mobyguard-token-issuer
REGISTRY_TOKEN_SERVICE=registry
REGISTRY_TOKEN_EXPIRY_MIN=15

# ==============================================================================
# Web UI Authentication & Security Key
# ==============================================================================
# MUST be at least 32 characters long (used for signing session JWT tokens)
JWT_SECURITY_KEY=change_this_to_a_random_32_character_security_key_here!
ACCESS_TOKEN_EXPIRY_MIN=15
REFRESH_TOKEN_EXPIRY_DAYS=7
