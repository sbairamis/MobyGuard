{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "JwtOptions": {
    "Issuer": "mobyguard-api",
    "Audience": "mobyguard-api",
    "SecurityKey": "",
    "TokenExpiryDays": 5
  },
  "RegistryTokenOptions": {
    "Issuer": "mobyguard-token-issuer",
    "Service": "registry",
    "CertificatePath": "/app/certs/registry-auth.crt",
    "PrivateKeyPath": "/app/certs/registry-auth.key",
    "TokenExpiryMinutes": 15,
    "RegistryUrl": "http://registry:5000"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=;Port=;Database=;Username=;Password=;",
    "RedisConnection": "localhost:6379,password="
  },
  "HostingOptions": {
    "Scheme": "http",
    "Ip": "0.0.0.0",
    "Port": 5090
  },
  "CorsPolicyOptions": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "AllowedHosts": "io2.olympia-electronics.com;localhost"
}
